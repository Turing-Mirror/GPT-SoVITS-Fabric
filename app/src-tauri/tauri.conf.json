{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPT-SoVITS Fabric",
  "version": "1.5.5",
  "identifier": "com.turingmirror.gptsovitsfabric",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Turing-Mirror",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../frontend",
      "../i18n/locales",
      "engine-payload/assets",
      "engine-payload/configs",
      "engine-payload/i18n",
      "engine-payload/logs",
      "engine-payload/tools",
      "engine-payload/legal",
      "engine-payload/.env",
      "engine-payload/setup_package.json",
      "engine-payload/LICENSE",
      "engine-payload/README.md"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "../../assets/brand/app.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cnb.cool/Turing-Mirror/RVC-Fabric-Releases/-/git/raw/main/updater.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MzNGQ0Y0Qjk1OTBEMkMKUldRc0RWbTU5UHd6MVhJTmVYQ0V3NldHN1krdW8wcjNjZzJQRGQ1ZU1kL01jbmNTQWVxQkk5OGUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}